# Export these variables in your shell. ARL does not automatically load .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
XAI_API_KEY=
GROK_MODEL=grok-4.7
ARL_DEFAULT_PROVIDER=deepseek
ARL_LLM_TIMEOUT_SECONDS=30
# Optional DeepSeek temperature; omitted by default, never sent to Grok.
ARL_LLM_TEMPERATURE=

ARL_PORT=8080
# Optional file-backed SQLite database. Blank uses an in-memory DB reset on restart.
ARL_DB_PATH=
